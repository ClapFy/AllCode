<?xml version="1.0" encoding="utf-8"?>
<!-- T3 servers on a LAN or tailnet usually speak plain http, so cleartext is allowed. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
